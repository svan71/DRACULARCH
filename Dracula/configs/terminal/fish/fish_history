# Curated fish history - common commands for fresh installs
# Copy to ~/.local/share/fish/fish_history

# System updates
- cmd: sudo pacman -Syu
  when: 1700000000
- cmd: yay -Syu
  when: 1700000001
- cmd: yay -Sc
  when: 1700000002
- cmd: sudo pacman -Sc
  when: 1700000003

