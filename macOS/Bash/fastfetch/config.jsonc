{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/arch-tahoe.png",
    "width": 43,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[38;2;0;145;255m{user-name}\u001b[38;2;90;200;250m@\u001b[38;2;0;145;255m{host-name}\u001b[0m"
    },
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "format": "{2}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󰧨 WM",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": " WM Theme",
      "keyColor": "cyan"
    },
    {
      "type": "theme",
      "key": " Theme",
      "keyColor": "cyan"
    },
    {
      "type": "icons",
      "key": " Icons",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "format": "{1}",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "format": "{1} {2}",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "white"
    },
    {
      "type": "localip",
      "key": "󰈀 Local IP",
      "keyColor": "white"
    },
    "break"
  ]
}
