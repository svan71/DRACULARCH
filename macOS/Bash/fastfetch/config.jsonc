{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/arch-tahoe.png",
    "width": 28,
    "padding": {
      "top": 1,
      "left": 1
    },
    "color": {
      "1": "#0091ff",
      "2": "#0091ff",
      "3": "#0091ff",
      "4": "#0091ff",
      "5": "#0091ff",
      "6": "#0091ff"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#5ac8fa",
      "output": "#dedede"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#0091ff",
        "at": "#dedede",
        "host": "#0091ff"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#555555"
    },
    "os",
    {
      "type": "host",
      "format": "{2}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "terminal",
    {
      "type": "cpu",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "format": "{2}"
    },
    "memory",
    "localip"
  ]
}
